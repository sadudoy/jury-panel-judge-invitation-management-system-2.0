# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL / Supabase Connection (Backend Only)
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSL=true

# Session & CSRF Signing Secret (optional; random ephemeral fallback generated if omitted)
SESSION_SECRET=

# Initial Admin Seed Credentials (used by db/seed script)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=BAUST CSE Fest Admin

# Login Screen 1-Click Demo Autofill (set to false to disable in production)
ENABLE_DEMO_AUTOFILL=true
